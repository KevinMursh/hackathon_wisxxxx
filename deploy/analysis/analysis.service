[Unit]
Description=ntpc-law3 analysis API (pipeline s2-s6, objection, lawlib) :8100
After=network.target

[Service]
WorkingDirectory=/opt/app/experiments
Environment=AWS_REGION=us-west-2
Environment=DDB_TABLE=appeal-cases
Environment=ANALYSIS_DDB=1
Environment=ANALYSIS_RUNS=/var/lib/analysis/runs
ExecStart=/opt/venv-analysis/bin/uvicorn api:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=3
MemoryMax=1.2G

[Install]
WantedBy=multi-user.target
