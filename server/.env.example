# 本機開發用；EC2 走 Instance Profile 時 AWS_PROFILE 留空
AWS_PROFILE=hackathon
AWS_REGION=us-west-2

# Bedrock
MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# 起跑間隔（秒）＋同時在途上限。規範限的是每秒請求數，非同時數；
# 2.0 × 3 = 起跑 0.5 RPS、最多 3 個在途。現場頻繁節流就把 CONCURRENCY 設 1 回到序列。
BEDROCK_MIN_INTERVAL=2.0
BEDROCK_CONCURRENCY=3

# 分類裝箱：每箱檔數上限（另有 20 圖 / 120k 字上限，先到先開新箱）
BOX_FILES=10
# 本機分類 cache（server/.cache/）；設 0 強制真打
CLASSIFY_CACHE=1

# 儲存
S3_BUCKET=ntpc-law3-deploy-229004791954
DDB_TABLE=appeal-cases
# 本機開發前綴，與正式資料隔離（S3 key 前綴 + DynamoDB PK 命名空間）
S3_PREFIX=dev/
